# Turso 数据库（留空则使用本地 file:./data/local.db）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare Workers AI（legacy，仅 LLM_PROVIDER=workersai 时使用）
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_AI_MODEL=

# 商汤日日新 LLM（默认 provider）
# 所有模型（sensenova / deepseek / glm）共用同一 base_url 与 API key
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sensenova-6.8-flash-lite
# provider 优先级：sensenova(默认) | deepseek | glm | workersai
# sensenova 挂时自动 fallback 到 deepseek-v4-flash / glm-5.2
LLM_PROVIDER=sensenova

# 本地开发代理（Node fetch 不读系统代理；GH Actions 上无需设置，留空即可）
HTTPS_PROXY=
